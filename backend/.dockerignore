# Patterns use the **/ prefix so they match at any depth of the build context.
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/env
**/pip-log.txt
**/pip-delete-this-directory.txt
**/.tox
**/.coverage
**/.coverage.*
**/.cache
**/nosetests.xml
**/coverage.xml
**/*.cover
**/*.log
**/.git
**/.mypy_cache
**/.pytest_cache
**/.hypothesis

**/.DS_Store
**/.vscode
**/.idea
**/*.swp
**/*.swo
**/*~

# Django specific
**/local_settings.py
**/db.sqlite3
**/db.sqlite3-journal
**/media
**/staticfiles

# Environment variables
**/.env

# Local tooling
**/.venv
**/node_modules
