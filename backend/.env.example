# Copia este archivo como .env y completa los valores
# El archivo .env está en .gitignore — nunca lo subas al repositorio

# Django
SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True

# PostgreSQL
DB_NAME=NauticDB
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# Módulo de visión (vision/) — todas tienen default en settings.py.
# Solo hace falta definirlas si cambias los valores de desarrollo.
# ─────────────────────────────────────────────────────────────────────────────

# Directorio con los pesos del modelo (los resuelve core_engine v3). Debe
# contener p. ej. yolo11s-seg-0.1.0.pt para el modelo yolo-seg.
# Sin esto la inferencia falla con FileNotFoundError (core_engine instalado
# como paquete no encuentra el fallback <repo>/models).
NAUTIC_WEIGHTS_DIR=/ruta/absoluta/a/nautic_core/models

# Id del modelo de core_engine: yolo-seg | yolo-tiled | maskrcnn | rtdetr
VISION_MODEL_ID=yolo-seg

# Broker Celery (RabbitMQ). Prod: amqp://user:pass@host:5672/vhost
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Ejecuta las tareas inline, sin broker. Usar en tests/CI.
CELERY_TASK_ALWAYS_EAGER=False

# Redis — pub/sub de eventos SSE y contadores de rate limiting
REDIS_URL=redis://localhost:6379/0

# Segundos entre keepalives del stream SSE
SSE_KEEPALIVE_SECONDS=15

# Rate limiting por IP.
# MAX_CONCURRENT debe coincidir con el límite de subidas simultáneas del frontend.
VISION_RATE_LIMIT_UPLOADS_PER_MINUTE=20
VISION_RATE_LIMIT_MAX_CONCURRENT=10
