# Copia este archivo como .env y completa los valores
# El archivo .env está en .gitignore — nunca lo subas al repositorio

# Django
SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True

# PostgreSQL
DB_NAME=rondasdos
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# Módulo de visión (vision/) — todas tienen default en settings.py.
# Solo hace falta definirlas si cambias los valores de desarrollo.
# ─────────────────────────────────────────────────────────────────────────────

# Broker Celery (RabbitMQ). Prod: amqp://user:pass@host:5672/vhost
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Ejecuta las tareas inline, sin broker. Usar en tests/CI.
CELERY_TASK_ALWAYS_EAGER=False

# Redis — pub/sub de eventos SSE y contadores de rate limiting
REDIS_URL=redis://localhost:6379/0

# Segundos entre keepalives del stream SSE
SSE_KEEPALIVE_SECONDS=15

# Rate limiting por IP.
# OJO: si cambias MAX_CONCURRENT, actualiza también CONCURRENT_LIMIT
# en frontend/src/components/AIInspection.js — deben coincidir.
VISION_RATE_LIMIT_UPLOADS_PER_MINUTE=20
VISION_RATE_LIMIT_MAX_CONCURRENT=10
