# =============================================================================
# Nautic monorepo — files that must never reach the remote
# frontend/ has its own .gitignore for Vite-specific outputs.
# =============================================================================

# --- Secrets / local environment ---
.env
.env.*
!.env.example

# --- Local agent / editor tooling ---
.claude/settings.local.json
.atl/
.vscode/
.idea/
*.swp
*.swo
pyrightconfig.json

# --- OS files ---
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.py[cod]
.Python
*.egg-info/
.venv/
venv/
env/
# pyenv local version (machine specific; requires-python lives in pyproject.toml)
.python-version
.uv/

# --- Python tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
htmlcov/
.coverage
.coverage.*
**/.cache/

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
# User uploads (inspection photos and annotated images)
media/
staticfiles/
static_root/

# --- Celery ---
celerybeat-schedule
celerybeat-schedule.db
*.pid

# --- Node / frontend ---
node_modules/
coverage/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# pnpm — personal local use only; the team uses npm + package-lock.json
pnpm-lock.yaml
pnpm-workspace.yaml
.npmrc
